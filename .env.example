# Supabase dashboard → Project Settings → API (or the Connect button)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Secret key (sb_secret_...) or the legacy service_role key. Server-only:
# never prefix it with NEXT_PUBLIC_ or use it in browser code.
SUPABASE_SECRET_KEY=""
# Random string, at least 32 characters (signs login cookies)
SESSION_SECRET=""
# Public URL of the site, used in password-reset links
APP_URL="http://localhost:3000"
# The one admin login (an email or a plain username). Change it here and restart the server.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Gmail address + app password for receipts and reset emails
GMAIL_USER=""
GMAIL_PASS=""
